# AI Talent의 Azure OpenAI 호환 게이트웨이를 사용할 때 세 값을 함께 설정합니다.
AI_TALENT_API_KEY=
AI_TALENT_ENDPOINT=
AI_TALENT_API_VERSION=2024-12-01-preview

# 게이트웨이를 설정하지 않을 때 사용하는 OpenAI 직접 연결 fallback입니다.
OPENAI_API_KEY=your-openai-api-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# 직접 OpenAI fallback에서만 사용됩니다. AI Talent 연결 시 gpt-5.4로 고정됩니다.
CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
SIM_THRESHOLD=0.25
SIMILAR_MEMORY_THRESHOLD=0.82
TOP_K=8
CATALOG_CACHE_TTL=30
MAX_CONTEXT_CHARS=12000
MAX_CATALOG_ROWS=5000
MAX_INGEST_CHARS=20000

APP_ENV=development
SESSION_TTL_SECONDS=43200
COOKIE_SECURE=false
SIGNUP_ENABLED=true

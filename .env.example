# GPT-5.4 채팅 Azure 배포를 사용할 때 네 값을 함께 설정합니다.
AZURE_OPENAI_54_API_KEY=
AZURE_OPENAI_54_ENDPOINT=
AZURE_OPENAI_54_API_VERSION=2025-04-01-preview
AZURE_OPENAI_54_DEPLOYMENT_NAME=gpt-5.4

# 기존 AI Talent 호환 게이트웨이 fallback입니다.
AI_TALENT_API_KEY=
AI_TALENT_ENDPOINT=
AI_TALENT_API_VERSION=2024-12-01-preview

# GPT-5.4 채팅 사용 시에도 기존 small 임베딩 검색에 사용합니다.
OPENAI_API_KEY=your-openai-api-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# GPT-5.4/AI Talent 채팅을 설정하지 않은 직접 OpenAI fallback에서만 사용됩니다.
CHAT_MODEL=gpt-4o-mini
# 기존 기억과 같은 벡터 공간을 유지하려면 전량 재임베딩 전까지 바꾸지 않습니다.
EMBED_MODEL=text-embedding-3-small
SIM_THRESHOLD=0.25
SIMILAR_MEMORY_THRESHOLD=0.82
TOP_K=8
CATALOG_CACHE_TTL=30
MAX_CONTEXT_CHARS=12000
MAX_CATALOG_ROWS=5000
MAX_INGEST_CHARS=20000

APP_ENV=development
SESSION_TTL_SECONDS=43200
COOKIE_SECURE=false
SIGNUP_ENABLED=true
